---
import '@fontsource-variable/figtree';
import '@fontsource/fragment-mono/400.css';
import '@fontsource-variable/climate-crisis/year.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';

interface Props {
  title: string;
  description: string;
  image?: string;
  bare?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  articleData?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    category?: string;
    tags?: string[];
  };
  breadcrumbs?: Array<{ name: string; url?: string }>;
}

const {
  title,
  description,
  image = '/assets/site/og.jpg',
  bare = false,
  noindex = false,
  ogType = 'website',
  articleData,
  breadcrumbs,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://mitce.run');

// Ensure canonical URL always has consistent trailing slash for clean directories
let pathName = Astro.url.pathname;
if (!pathName.endsWith('/') && !pathName.includes('.')) {
  pathName += '/';
}
const canonical = new URL(pathName, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${new URL('/', siteUrl).href}#organization`,
      name: site.brand || 'Mitce',
      url: new URL('/', siteUrl).href,
      logo: new URL('/favicon.png', siteUrl).href,
      sameAs: [],
    },
    {
      '@type': 'WebSite',
      '@id': `${new URL('/', siteUrl).href}#website`,
      url: new URL('/', siteUrl).href,
      name: site.brand || 'Mitce',
      description: 'Mitce (mitce.run) — 2026 高可用网络专线与 42 家机场权威可观测性评测实验室',
      publisher: {
        '@id': `${new URL('/', siteUrl).href}#organization`,
      },
    },
    ...(breadcrumbs && breadcrumbs.length > 0
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: breadcrumbs.map((b, idx) => ({
              '@type': 'ListItem',
              position: idx + 1,
              name: b.name,
              item: b.url ? new URL(b.url, siteUrl).href : canonical,
            })),
          },
        ]
      : []),
    ...(ogType === 'article' && articleData
      ? [
          {
            '@type': 'BlogPosting',
            '@id': `${canonical}#article`,
            isPartOf: {
              '@id': `${new URL('/', siteUrl).href}#website`,
            },
            headline: title,
            description: description,
            image: ogImage,
            datePublished: articleData.publishedTime,
            dateModified: articleData.modifiedTime || articleData.publishedTime,
            mainEntityOfPage: canonical,
            author: articleData.authors?.map((name) => ({
              '@type': 'Person',
              name,
            })) ?? [{ '@type': 'Organization', name: site.brand || 'Mitce' }],
            publisher: {
              '@id': `${new URL('/', siteUrl).href}#organization`,
            },
          },
        ]
      : []),
  ],
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Mitce RSS Feed" href="/rss.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Mitce" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {ogType === 'article' && articleData?.publishedTime && (
      <meta property="article:published_time" content={articleData.publishedTime} />
    )}
    {ogType === 'article' && articleData?.modifiedTime && (
      <meta property="article:modified_time" content={articleData.modifiedTime} />
    )}
    {ogType === 'article' && articleData?.category && (
      <meta property="article:section" content={articleData.category} />
    )}
    {ogType === 'article' && articleData?.tags?.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Search Engine Webmaster Verification Meta Tags -->
    {site.verification?.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification?.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    {site.verification?.shenma && <meta name="shenma-site-verification" content={site.verification.shenma} />}
    {site.verification?.baidu && <meta name="baidu-site-verification" content={site.verification.baidu} />}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </head>
  <body>
    {!bare && <Nav />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/entry';
    </script>
  </body>
</html>
