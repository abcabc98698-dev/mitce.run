---
import site from '../content/site.json';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
const { nav } = site;
---
<div class="topbar" data-fx="nav">
  <nav class="nav" aria-label="Main">
    <div class="bar">
      <div class="capsule">
        <a class="t-logo logo" href="/">{site.brand}</a>
        <div class="links desktop-only">
          {nav.links.map((l) => <a class="t-body-m link" href={l.href}>{l.label}</a>)}
        </div>
        <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu" tabindex="-1">
          <Icon name="dots-nine" class="i-open" />
          <Icon name="x" class="i-close" />
        </button>
      </div>
      <div class="buttons desktop-only">
        <Button href={nav.login.href} variant="ghost">{nav.login.label}</Button>
        <Button href={nav.demo.href}>{nav.demo.label}</Button>
      </div>
    </div>
    <div class="menu below-desktop" id="nav-menu">
      <div class="menu-links">
        {nav.links.map((l) => <a class="t-body-m menu-link" href={l.href}>{l.label}</a>)}
      </div>
      <div><Button href={nav.demo.href}>{nav.demo.label}</Button></div>
    </div>
  </nav>
</div>
<style>
  .topbar { position: sticky; top: 0; z-index: 5; width: 100%; max-width: var(--canvas); margin: 0 auto; }
  .nav { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 20px; height: 91px; }
  .bar { display: flex; align-items: center; justify-content: space-between; }
  .capsule, .buttons { background: var(--surface); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 16px; }
  .capsule {
    display: flex; align-items: center; justify-content: center; gap: 64px; padding: 12px 24px;
    transition: gap 0.45s cubic-bezier(0.2, 0.715, 0.205, 0.99);
  }
  .logo { font-size: 16px; text-align: center; }
  .links {
    display: flex; align-items: center; gap: 16px; overflow: hidden; max-width: 480px;
    transition: opacity 0.45s cubic-bezier(0.2, 0.715, 0.205, 0.99), max-width 0.45s cubic-bezier(0.2, 0.715, 0.205, 0.99);
  }
  .link { color: var(--white); white-space: nowrap; user-select: none; }
  .nav-toggle { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 8px; color: var(--grey); cursor: default; }
  .nav-toggle :global(.i-close) { display: none; }
  .buttons { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 7px; }
  /* Desktop: past the top of the page the links fold away until the capsule is pointed at. */
  .topbar.is-collapsed .capsule { gap: 36px; }
  .topbar.is-collapsed .links { opacity: 0; max-width: 0; }

  .menu {
    position: absolute; left: 16px; right: 16px; top: 72px; display: flex; flex-direction: column; gap: 20px; padding: 16px;
    background: rgba(16, 16, 16, 0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 16px;
    opacity: 0; pointer-events: none; transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-links { display: flex; flex-direction: column; gap: 14px; }
  .menu-link { color: var(--white); }

  @media (max-width: 1199.98px) {
    .nav { padding: 16px; height: 77px; }
    .bar { justify-content: flex-start; }
    .capsule { width: 100%; justify-content: space-between; }
    .nav-toggle { cursor: pointer; }
    .topbar.is-open .menu { opacity: 1; pointer-events: auto; }
    .topbar.is-open .nav-toggle :global(.i-open) { display: none; }
    .topbar.is-open .nav-toggle :global(.i-close) { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) { .capsule, .links, .menu { transition: none; } }
</style>
