---
/**
 * "UI/Contact Submit": the contact form's submit button with its four states.
 * The label swaps through data-state (idle | sending | success | error), set by
 * src/scripts/fx/contact-form.js. Labels come in as props so the copy stays in
 * the page's content file.
 */
interface Props {
  labels: { idle: string; sending: string; success: string; error: string };
}
const { labels } = Astro.props;
---
<button
  type="submit"
  class="submit"
  data-state="idle"
  data-label-idle={labels.idle}
  data-label-sending={labels.sending}
  data-label-success={labels.success}
  data-label-error={labels.error}
>
  <span class="glow-wrap" aria-hidden="true"><span class="glow"></span></span>
  <span class="surface" aria-hidden="true"></span>
  <span class="label t-body-m" aria-live="polite">{labels.idle}</span>
</button>
<style>
  .submit {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    padding: 12px 26px; border-radius: 8px; flex: none; cursor: pointer;
  }
  .glow-wrap {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center;
    padding: 2px 0; transition: padding 0.4s var(--ease-framer);
  }
  .glow {
    width: 100%; flex: 1; border-radius: 9px; opacity: 0; background: rgb(77, 197, 229);
    box-shadow: 0 0 8px 0 rgba(77, 197, 229, 0.7), 0 2px 6px 0 rgba(77, 197, 229, 0.7), 0 3px 8px 0 rgba(99, 173, 69, 0.7), 0 6px 16px 0 rgba(233, 211, 82, 0.7), 0 8px 22px 0 rgba(77, 197, 229, 0.7);
    transition: opacity 0.4s var(--ease-framer);
    animation: submit-hue 2s linear infinite;
  }
  .surface {
    position: absolute; inset: 0; border-radius: 8px; background: var(--white);
    transition: background-color 0.4s var(--ease-framer);
  }
  .label {
    position: relative; z-index: 1; white-space: nowrap; user-select: none; text-align: center; color: var(--black);
    transition: color 0.4s var(--ease-framer);
  }
  /* Sending, Sent and Error: the surface drops to the translucent Surface fill. */
  .submit:not([data-state='idle']) .surface { background: var(--surface); }
  .submit:not([data-state='idle']) .label { color: var(--grey); text-align: start; }
  .submit[data-state='sending'] { cursor: progress; }
  @media (hover: hover) {
    .submit[data-state='idle']:hover .glow-wrap { padding: 0; }
    .submit[data-state='idle']:hover .glow { opacity: 1; }
  }
  @keyframes submit-hue { to { filter: hue-rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .glow { animation: none; }
  }
</style>
