---
/**
 * The template's one button. Three looks: primary (white), ghost (text only)
 * and secondary (outlined). On hover a hue-cycling glow fades in behind it.
 */
interface Props { href: string; variant?: 'primary' | 'ghost' | 'secondary'; class?: string; [key: string]: unknown; }
const { href, variant = 'primary', class: cls, ...rest } = Astro.props;
---
<a href={href} class:list={['btn', `btn--${variant}`, cls]} {...rest}>
  <span class="btn-glow-wrap" aria-hidden="true"><span class="btn-glow"></span></span>
  <span class="btn-surface" aria-hidden="true"></span>
  <span class="btn-label t-body-m"><slot /></span>
</a>
<style>
  .btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    padding: 9px 25px; border-radius: 8px; flex: none; cursor: pointer;
  }
  .btn-glow-wrap {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center;
    padding: 2px 0; transition: padding 0.4s var(--ease-framer);
  }
  .btn-glow {
    width: 100%; flex: 1; border-radius: 9px; opacity: 0;
    box-shadow: 0 0 8px 0 rgba(77, 197, 229, 0.7), 0 2px 6px 0 rgba(77, 197, 229, 0.7), 0 3px 8px 0 rgba(99, 173, 69, 0.7), 0 6px 16px 0 rgba(233, 211, 82, 0.7), 0 8px 22px 0 rgba(77, 197, 229, 0.7);
    transition: opacity 0.4s var(--ease-framer);
    animation: btn-hue 2s linear infinite;
  }
  .btn--primary .btn-glow { background: rgb(77, 197, 229); }
  .btn-surface { position: absolute; inset: 1px; border-radius: 8px; }
  .btn--primary .btn-surface { background: var(--white); }
  .btn--secondary .btn-surface { box-shadow: inset 0 0 0 1px var(--grey-20); }
  .btn-label { position: relative; z-index: 1; white-space: nowrap; user-select: none; text-align: center; }
  .btn--primary .btn-label { color: var(--black); }
  .btn--ghost .btn-label { color: var(--grey); }
  .btn--secondary .btn-label { color: var(--white); }
  @media (hover: hover) {
    .btn:hover .btn-glow-wrap { padding: 0; }
    .btn:hover .btn-glow { opacity: 1; }
  }
  @keyframes btn-hue { to { filter: hue-rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .btn-glow { animation: none; }
  }
</style>
