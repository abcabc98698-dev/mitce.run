---
/**
 * Billing toggle + the three plan cards (Framer "Plan Cards" on /pricing,
 * "Plans" on the home page). Copy and prices live in src/content/plans.json.
 *
 * Behaviour (src/scripts/fx/billing-toggle.js): the Monthly/Annual buttons
 * swap every element on the page that carries data-price-monthly /
 * data-price-annual, so a comparison table elsewhere on the page follows too.
 * Without JS the monthly prices show.
 *
 * Props (all optional):
 *   class    extra class on the root
 *   nameTag  heading tag for the plan names: 'h2' (pricing page, default) or 'h3' (home)
 */
import plans from '../../content/plans.json';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props { class?: string; nameTag?: 'h2' | 'h3'; }
const { class: cls, nameTag = 'h2' } = Astro.props;
const Name = nameTag;
const { toggle } = plans;
---
<div class:list={['plans', cls]} data-fx="billing-toggle" data-billing-state="monthly">
  <div class="toggle" role="group" aria-label={toggle.label}>
    <button type="button" class="tab" data-billing="monthly" aria-pressed="true">
      <span class="tab-bg" aria-hidden="true"></span>
      <span class="tab-label t-label">{toggle.monthly}</span>
    </button>
    <button type="button" class="tab" data-billing="annual" aria-pressed="false">
      <span class="tab-bg" aria-hidden="true"></span>
      <span class="tab-label t-label">{toggle.annual}</span>
      <span class="save"><span class="save-pill"><span class="pill-text">{toggle.save}</span></span></span>
    </button>
  </div>

  <div class="tiers">
    {plans.plans.map((plan, i) => (
      <article
        class:list={['card', `card--${plan.id}`, { 'card--featured': plan.featured }]}
        data-fx={plan.featured ? undefined : 'appear'}
        style={plan.featured ? undefined : `--appear-delay: ${i === 0 ? 0 : 0.08}s`}
      >
        {plan.featured && (
          <div class="glows" aria-hidden="true">
            <span class="glow glow--right"></span>
            <span class="glow glow--left"></span>
            <span class="glow glow--centre"></span>
          </div>
        )}
        <div class="head">
          <Name class:list={['t-h4', { balance: nameTag === 'h2' }]}>{plan.name}</Name>
          {plan.badge && <p class="badge"><span class="pill-text">{plan.badge}</span></p>}
        </div>
        <p class="description t-body-m">{plan.description}</p>
        <div class="price">
          <p
            class="amount t-num"
            data-price-monthly={plan.price.monthly !== plan.price.annual ? plan.price.monthly : undefined}
            data-price-annual={plan.price.monthly !== plan.price.annual ? plan.price.annual : undefined}
          >{plan.price.monthly}</p>
          <p class="unit t-eyebrow">{plan.unit}</p>
        </div>
        <div class="divider" aria-hidden="true"></div>
        <ul class="features">
          {plan.features.map((f) => (
            <li class="feature">
              <span class="tick" aria-hidden="true"><Icon name="check" size={10} /></span>
              <span class="t-body-s">{f}</span>
            </li>
          ))}
        </ul>
        <Button href={plan.button.href} variant={plan.button.variant as 'primary' | 'secondary'} class="card-btn">{plan.button.label}</Button>
      </article>
    ))}
  </div>
</div>

<style>
  .plans { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 40px; }

  /* Billing toggle */
  .toggle {
    display: flex; align-items: center; gap: 4px; padding: 4px;
    border-radius: 12px; background: var(--surface); overflow: clip;
  }
  .tab {
    position: relative; display: flex; align-items: center; justify-content: center; gap: 9px;
    height: 38px; padding: 9px 18px; border-radius: 8px; overflow: clip; flex: none;
  }
  .tab-bg { position: absolute; inset: 0; border-radius: 8px; background: var(--white); visibility: hidden; }
  .tab-label { position: relative; z-index: 1; color: rgb(102, 102, 102); user-select: none; white-space: nowrap; }
  .tab[aria-pressed='true'] .tab-bg { visibility: visible; }
  .tab[aria-pressed='true'] .tab-label { color: var(--black); }
  .save {
    position: relative; z-index: 1; display: flex; padding: 1px; border-radius: 999px;
    background-image: linear-gradient(90deg, rgb(235, 206, 127) 0%, rgb(205, 32, 202) 52.4%, rgb(195, 32, 35) 100%);
  }
  .save-pill {
    display: flex; align-items: center; justify-content: center; padding: 4px 8px; border-radius: 999px;
    background: rgb(28, 28, 28); color: var(--grey); overflow: clip; user-select: none; white-space: nowrap;
    font-family: var(--font-mono); font-size: 10px; line-height: 1.2em; letter-spacing: 0.8px;
  }
  /* Annual chosen: the pill turns light (Framer "Save Badge Ring Light"). */
  .tab[aria-pressed='true'] .save-pill { background: var(--white); color: var(--black); }

  /* Cards */
  .tiers { width: 100%; display: flex; align-items: center; gap: 20px; }
  .card {
    position: relative; flex: 1 1 0; min-width: 0;
    display: flex; flex-direction: column; align-items: flex-start; gap: 22px;
    padding: 32px; border-radius: var(--radius); background: var(--surface); overflow: clip;
  }
  .card > :not(.glows) { position: relative; z-index: 1; }
  .card--featured { height: 560px; box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.5); }

  .head { width: 100%; display: flex; justify-content: space-between; align-items: center; }
  .badge {
    display: flex; align-items: center; justify-content: center; padding: 4px 11px; border-radius: 8px;
    background: var(--white); color: var(--black); overflow: clip;
    font-family: var(--font-mono); font-size: 10px; line-height: 1.2em; letter-spacing: 0.8px;
  }
  .description { width: 100%; color: var(--dark-grey); }
  .price { width: 100%; display: flex; flex-direction: column; gap: 9px; }
  .pill-text { display: block; }
  .amount { color: var(--white); }
  .divider { width: 100%; height: 1px; flex: none; background: var(--grey-20); }
  .features { width: 100%; list-style: none; display: flex; flex-direction: column; gap: 13px; }
  .feature { display: flex; align-items: flex-start; gap: 11px; }
  .feature .t-body-s { flex: 1 1 0; min-width: 0; color: var(--grey); }
  .card--featured .feature .t-body-s { color: var(--white); }
  .tick {
    width: 16px; height: 16px; flex: none; display: flex; align-items: center; justify-content: center;
    border-radius: 999px; box-shadow: inset 0 0 0 1px var(--grey-20); color: var(--grey);
  }
  .card--featured .tick { color: var(--white); }
  .tick :global(path) { stroke-width: 2; }
  .card :global(.card-btn) { width: 100%; }

  /* Growth card glow: three blurred blobs sat low in the card, each drifting
     on its own mirrored loop (Framer loopEffect, tween 0.4,0,0.6,1). */
  .glows { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .glow { position: absolute; border-radius: 999px; filter: blur(90px); will-change: transform; }
  .glow--right { left: 237px; top: 545px; width: 137px; height: 137px; background: #cd20ca; animation: glow-right 9.5s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate; }
  .glow--left { left: -39px; top: 566px; width: 152px; height: 152px; background: #fdd124; animation: glow-left 7.5s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate; }
  .glow--centre { left: 92px; top: 502px; width: 207px; height: 194px; background: #c32023; animation: glow-centre 11s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate; }
  @keyframes glow-right { to { transform: translate(-28px, -22px) scale(1.1) rotate(360deg); } }
  @keyframes glow-left { to { transform: translate(34px, -18px) scale(1.18) rotate(360deg); } }
  @keyframes glow-centre { to { transform: translate(22px, -26px) scale(1.12) rotate(360deg); } }

  /* Appear on scroll (Starter, Enterprise): y 80 -> 0, fade in. Only when
     scripts run, so the cards stay visible with JS off. */
  .card[data-fx~='appear'] {
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--appear-delay, 0s);
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .card[data-fx~='appear']:not(.is-in) { opacity: 0; transform: translateY(80px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .glow { animation: none; }
  }

  @media (max-width: 1199.98px) {
    .tiers { flex-direction: column; gap: 16px; }
    .card { width: 100%; flex: none; }
    .card--featured { height: auto; }
  }
  @media (max-width: 809.98px) {
    .tiers { gap: 12px; }
    .card { padding: 20px; }
    .card--featured { padding: 60px 20px; }
  }
</style>
