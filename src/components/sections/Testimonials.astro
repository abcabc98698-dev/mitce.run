---
import home from '../../content/pages/home.json';
import Icon from '../ui/Icon.astro';
const { testimonials } = home;
const [first, second] = testimonials.title.split('\n');
---
<section class="testimonials">
  <div class="panel">
    <div class="waves" data-fx="flow-lines" aria-hidden="true"></div>
    <div class="title"><h2 class="t-h2 balance">{first}<br />{second}</h2></div>
    <div class="rolling" data-fx="ticker">
      <div class="ticker-track">
        {testimonials.quotes.map((q) => (
          <figure class:list={['quote', { compact: q.compact }]}>
            {q.icon && <Icon name="quote" size={24} class="quote-icon" />}
            <blockquote>{q.compact ? <p class="t-h5">{q.quote}</p> : <h3 class="t-h5">{q.quote}</h3>}</blockquote>
            <figcaption class="author">
              <p class="t-label name">{q.name}</p>
              <p class="t-eyebrow role">{q.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .testimonials { width: 100%; max-width: var(--canvas); margin: 0 auto; height: 900px; padding: 100px 20px; display: flex; }
  .panel { position: relative; flex: 1 1 0; height: 700px; border-radius: 16px; background: var(--black); overflow: clip; }
  .waves { position: absolute; inset: 0; overflow: hidden; }
  .title { position: absolute; left: 20px; bottom: 30px; width: 364px; height: 106px; }
  .rolling {
    position: absolute; right: 0; top: 0; width: 631px; height: 700px; padding: 20px; overflow: clip;
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.15) 5%, rgba(0,0,0,0.5) 10%, rgba(0,0,0,0.85) 15%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0.85) 85%, rgba(0,0,0,0.5) 90%, rgba(0,0,0,0.15) 95%, rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.15) 5%, rgba(0,0,0,0.5) 10%, rgba(0,0,0,0.85) 15%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0.85) 85%, rgba(0,0,0,0.5) 90%, rgba(0,0,0,0.15) 95%, rgba(0,0,0,0) 100%);
  }
  .ticker-track { display: flex; flex-direction: column; gap: 20px; will-change: transform; }
  .quote { margin: 0; display: flex; flex-direction: column; gap: 24px; padding: 32px; border-radius: 16px; background: rgba(16, 16, 16, 0.4); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); }
  .quote.compact { gap: 16px; }
  .quote :global(.quote-icon) { width: 24px; height: 17px; color: var(--dark-grey); }
  .quote :global(.quote-icon svg) { width: 24px; height: 17px; }
  blockquote { margin: 0; }
  .author { display: flex; flex-direction: column; gap: 8px; }
  .compact .author { gap: 0; }
  .name { color: var(--white); }
  .role { color: var(--grey); }

  @media (max-width: 1199.98px) {
    .testimonials { height: 760px; }
    .panel { height: 560px; }
    .title { width: 320px; height: auto; }
    .rolling { width: 380px; height: 560px; }
  }
  @media (max-width: 809.98px) {
    .testimonials { height: auto; padding: 64px 20px; }
    .panel { height: 840px; }
    .title { top: 24px; bottom: auto; width: 310px; height: 106px; }
    .rolling { top: 200px; width: 350px; height: auto; }
  }
</style>
