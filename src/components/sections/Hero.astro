---
import home from '../../content/pages/home.json';
import Button from '../ui/Button.astro';
const { hero } = home;
---
<section class="hero">
  <div class="hero-top">
    <div class="hero-title">
      <p class="t-eyebrow">{hero.eyebrow}</p>
      <h1 class="t-h1 balance">{hero.title}<span class="hero-muted">{hero.titleMuted}</span></h1>
    </div>
    <div class="side">
      <p class="t-body-m">{hero.description}</p>
      <Button href={hero.button.href}>{hero.button.label}</Button>
    </div>
  </div>
  <div class="hero-media">
    <div class="product">
      <img class="bg" src={hero.background} alt={hero.backgroundAlt} width="2400" height="1528" fetchpriority="high" />
      <img class="shot" src={hero.screenshot} alt={hero.screenshotAlt} width="1497" height="1024" fetchpriority="high" />
    </div>
    <div class="stats">
      {hero.stats.map((s) => (
        <div class="stat">
          <p class="t-num">{s.value}</p>
          <p class="t-eyebrow">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .hero { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 100px 20px; display: flex; flex-direction: column; align-items: center; gap: 80px; }
  .hero-top { width: 100%; display: flex; justify-content: space-between; align-items: flex-end; }
  .hero-title { width: 536px; display: flex; flex-direction: column; gap: 24px; }
  .hero-muted { color: var(--dark-grey); }
  .side { width: 273px; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .side > p { align-self: stretch; }
  .hero-media { width: 100%; display: flex; flex-direction: column; align-items: center; }
  .product { position: relative; width: 100%; height: 546px; padding-top: 53px; display: flex; justify-content: center; align-items: flex-start; border-radius: 16px; overflow: clip; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shot { position: relative; width: 89.14%; aspect-ratio: 1.46; height: auto; border-radius: 16px; flex: none; }
  .stats { width: 100%; display: flex; align-items: flex-start; gap: 20px; padding: 20px 0; }
  .stat { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; padding: 32px; border-radius: 16px; background: var(--surface); overflow: clip; }

  @media (max-width: 1199.98px) {
    .hero-top { flex-direction: column; align-items: flex-start; gap: 32px; }
    .hero-title, .side { width: 100%; }
    .product { height: 420px; }
  }
  @media (max-width: 809.98px) {
    .hero { padding: 64px 20px; }
    .hero-top { gap: 24px; }
    .product { height: 260px; padding-top: 24px; }
    .shot { border-radius: 8px; }
    .stats { flex-direction: column; gap: 12px; }
    .stat { width: 100%; flex: none; }
  }
</style>
