---
/** About page story: eyebrow + h2 on the left, four paragraphs on the right. */
import about from '../../content/pages/about.json';
const { story } = about;
---
<section class="about-story">
  <div class="title">
    <p class="t-eyebrow">{story.eyebrow}</p>
    <h2 class="t-h2 balance">{story.title}</h2>
  </div>
  <div class="body t-body-m">
    {story.body.map((p) => <p>{p}</p>)}
  </div>
</section>
<style>
  .about-story {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    display: flex; align-items: flex-start; gap: 80px; padding: 100px 20px;
  }
  .title { width: 472px; flex: none; display: flex; flex-direction: column; gap: 24px; }
  .body { flex: 1 0 0; min-width: 0; }
  .body p + p { margin-top: 20px; }
  @media (max-width: 1199.98px) {
    .about-story { flex-direction: column; gap: 40px; }
    .title, .body { width: 100%; flex: none; }
  }
  @media (max-width: 809.98px) {
    .about-story { gap: 32px; padding: 64px 20px; }
  }
</style>
