---
import Base from '../layouts/Base.astro';
import Plans from '../components/sections/Plans.astro';
import ComparePlans from '../components/sections/ComparePlans.astro';
import Faq from '../components/sections/Faq.astro';
import page from '../content/pages/pricing.json';
const { meta, top, faq } = page;
---
<Base title={meta.title} description={meta.description} image={meta.image}>
  <section class="pricing-top">
    <div class="pricing-title">
      <p class="t-eyebrow">{top.eyebrow}</p>
      <h1 class="t-h1 balance">{top.title}</h1>
      <p class="t-body-m balance pricing-description">{top.description}</p>
    </div>
  </section>
  <section class="plans-section" id="plans">
    <Plans />
  </section>
  <ComparePlans />
  <Faq eyebrow={faq.eyebrow} title={faq.title} card={faq.card} items={faq.items} />
</Base>

<style>
  .pricing-top, .plans-section { width: 100%; max-width: var(--canvas); margin: 0 auto; }
  .pricing-top { padding: 100px 20px; }
  .pricing-title { display: flex; flex-direction: column; gap: 24px; }
  .pricing-title h1 { max-width: 800px; }
  .pricing-description { max-width: 720px; }
  .plans-section { padding: 0 20px 100px; }
  @media (max-width: 809.98px) {
    .pricing-top { padding: 64px 20px; }
    .plans-section { padding: 0 20px 64px; }
  }
</style>
