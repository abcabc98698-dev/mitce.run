---
import Base from '../../layouts/Base.astro';
import ArticleTop from '../../components/sections/ArticleTop.astro';
import ArticleBody from '../../components/sections/ArticleBody.astro';
import BlogRow from '../../components/sections/BlogRow.astro';
import blog from '../../content/pages/blog.json';
import { getPosts, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  // Set to 4 for a full row of three on every post.
  const RELATED_LIMIT = 3;
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    // Related reading, as on the Design site: the RELATED_LIMIT newest posts,
    // minus this one if it is among them (so the newest posts show two cards).
    props: { post, related: posts.slice(0, RELATED_LIMIT).filter((p) => p.id !== post.id) },
  }));
}

interface Props { post: Post; related: Post[]; }
const { post, related } = Astro.props;
---
<Base
  title={post.data.title + blog.meta.postTitleSuffix}
  description={post.data.excerpt}
  image={post.data.cover}
  ogType="article"
  articleData={{
    publishedTime: post.data.date.toISOString(),
    authors: [post.data.author.name],
  }}
>
  <ArticleTop post={post} />
  <ArticleBody post={post} />
  {related.length > 0 && (
    <section class="related">
      <h2 class="t-h2 balance">{blog.related}</h2>
      <BlogRow posts={related} />
    </section>
  )}
</Base>

<style>
  .related {
    display: flex; flex-direction: column; align-items: flex-start; gap: 80px;
    max-width: var(--canvas); margin: 0 auto; padding: 40px 20px 100px;
  }
  .related h2 { width: 700px; max-width: 100%; }
  @media (max-width: 1199.98px) {
    .related { gap: 48px; }
    .related h2 { width: 100%; }
  }
  @media (max-width: 809.98px) {
    .related { gap: 32px; padding: 32px 20px 64px; }
  }
</style>
