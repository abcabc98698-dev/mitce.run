---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import WhatChanges from '../components/sections/WhatChanges.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import HomePricing from '../components/sections/HomePricing.astro';
import Faq from '../components/sections/Faq.astro';
import HomeBlog from '../components/sections/HomeBlog.astro';
import home from '../content/pages/home.json';
---
<Base title={home.meta.title} description={home.meta.description}>
  <Hero />
  <WhatChanges />
  <HowItWorks />
  <HomePricing />
  <Testimonials />
  <Faq {...home.faq} cardWidth="320px" tabletContentWidth="100%" />
  <HomeBlog />
</Base>
