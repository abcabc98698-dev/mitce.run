---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const title = '科学上网与代理客户端使用教程全集 (Windows/Mac/iOS/Android/软路由) — Mitce 推荐';
const description = '全平台代理客户端完整实操与网络排障教程库：涵盖 Clash Verge Rev、Shadowrocket（小火箭）、v2rayNG、sing-box、OpenClash 订阅导入、TUN 模式配置、分流规则定制与常见错误代码全解析。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '使用教程全集', url: '/tutorial/' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': title,
  'description': description,
  'url': 'https://mitce.run/tutorial/',
  'isPartOf': {
    '@type': 'WebSite',
    'name': 'Mitce',
    'url': 'https://mitce.run/'
  }
};
---
<Base title={title} description={description} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div class="pillar-page">
    <header class="page-header">
      <Breadcrumb items={breadcrumbs} />
      <div class="header-badge">
        <span class="status-dot"></span>
        <span class="mono-s">PILLAR MATRIX · COMPLETE TUTORIALS & RUNBOOKS</span>
      </div>
      <h1 class="t-h1 page-title">科学上网与代理客户端全平台实操教程全集</h1>
      <p class="t-body-m page-desc">
        从新手零基础导入订阅，到企业级透明网关与 TUN 模式调优。Mitce 实验室提供最详尽、保姆级的实战操作图文，彻底告别配置困扰与网络瘫痪。
      </p>

      <div class="cluster-nav">
        <a href="/clients/desktop/" class="cluster-pill is-active">桌面端教程 (Win / Mac)</a>
        <a href="/clients/mobile/" class="cluster-pill">移动端教程 (iOS / Android)</a>
        <a href="/clients/router/" class="cluster-pill">软路由教程 (OpenWrt)</a>
        <a href="/clash/" class="cluster-pill">Clash 分流规则库</a>
        <a href="/faq/" class="cluster-pill">83条高频答疑</a>
      </div>
    </header>

    <!-- Answer-First Block -->
    <section class="answer-box">
      <div class="answer-badge mono-s">GEO 核心决策摘要 · ANSWER-FIRST</div>
      <h2 class="t-h3 answer-heading">如何根据当前设备选择最适合的代理客户端？</h2>
      <p class="t-body-s answer-text">
        <strong>Windows / macOS 首选：Clash Verge Rev 或 sing-box</strong>，具备完整的图形化界面与内核服务模式，一键开启 TUN 模式可全局代理所有软件与命令行；<strong>iOS 首选：Shadowrocket（小火箭）或 Loon</strong>，轻巧省电且规则分流极其稳定；<strong>Android 首选：Clash Meta for Android 或 v2rayNG</strong>，支持分应用代理与一键订阅更新；<strong>软路由首选：OpenClash 或 passwall</strong>，实现全家智能电视、游戏主机透明加速。
      </p>
    </section>

    <!-- Platform Categorized Runbooks -->
    <section class="content-section">
      <h2 class="t-h2 section-heading">一、全平台客户端实操指引矩阵</h2>
      <div class="platform-grid">
        <div class="platform-card">
          <div class="platform-head">
            <span class="platform-badge mono-s">WINDOWS / MACOS</span>
            <h3 class="t-h3 platform-title">桌面端：Clash Verge Rev</h3>
          </div>
          <p class="t-body-s platform-desc">现代开源替代方案，支持 Mihomo 最新内核。深度适配 Apple Silicon M 系列芯片与 Windows 11，支持一键安装服务模式与 TUN 虚拟网卡。</p>
          <ul class="platform-bullets">
            <li>✓ 解决系统代理不接管 git/npm/Docker 痛点</li>
            <li>✓ 内置延迟优选与大模型智能分流</li>
            <li>✓ 支持本地一键订阅转换与多配置合并</li>
          </ul>
          <a href="/clients/desktop/" class="platform-link">进入桌面端完整教程 ↗</a>
        </div>

        <div class="platform-card">
          <div class="platform-head">
            <span class="platform-badge mono-s">IOS / IPADOS</span>
            <h3 class="t-h3 platform-title">苹果移动端：Shadowrocket (小火箭)</h3>
          </div>
          <p class="t-body-s platform-desc">iOS 平台装机必备经典工具。需使用美区 Apple ID 购买下载。完美支持 Shadowsocks、VLESS、Trojan 等全协议接入与按需求唤醒。</p>
          <ul class="platform-bullets">
            <li>✓ 扫码一键添加节点与自动更新订阅</li>
            <li>✓ 待机自动休眠，低功耗零发热</li>
            <li>✓ 原生支持按域名/IP 自动策略分流</li>
          </ul>
          <a href="/clients/mobile/" class="platform-link">进入 iOS 移动端教程 ↗</a>
        </div>

        <div class="platform-card">
          <div class="platform-head">
            <span class="platform-badge mono-s">ANDROID / 鸿蒙</span>
            <h3 class="t-h3 platform-title">安卓端：v2rayNG / Clash Meta</h3>
          </div>
          <p class="t-body-s platform-desc">原生开源免费客户端，无需 Google Play 框架即可直接安装。支持分应用代理（如仅让浏览器走代理，微信国内直连）。</p>
          <ul class="platform-bullets">
            <li>✓ 绕过局域网与大陆常用地址</li>
            <li>✓ 支持自定义路由规则与 DoH 加密 DNS</li>
            <li>✓ 兼容光速云及各大主流机场通用一键导入</li>
          </ul>
          <a href="/clients/mobile/" class="platform-link">进入安卓客户端教程 ↗</a>
        </div>

        <div class="platform-card">
          <div class="platform-head">
            <span class="platform-badge mono-s">OPENWRT / 软路由</span>
            <h3 class="t-h3 platform-title">路由器端：OpenClash 透明网关</h3>
          </div>
          <p class="t-body-s platform-desc">家庭与外贸团队网关级加速。局域网内所有设备（Apple TV、PS5、Switch、VR 头显）无需安装任何软件即可无缝连接外网。</p>
          <ul class="platform-bullets">
            <li>✓ Fake-IP 高性能 DNS 抢答与防投毒</li>
            <li>✓ 全家多设备并发晚高峰均衡调度</li>
            <li>✓ 彻底消除手机端电量与后台清理隐患</li>
          </ul>
          <a href="/clients/router/" class="platform-link">进入软路由实战教程 ↗</a>
        </div>
      </div>
    </section>

    <!-- Troubleshooting Cheat Sheet -->
    <section class="content-section">
      <h2 class="t-h2 section-heading">二、新手高频报错 3 秒速查速决</h2>
      <div class="table-container">
        <table class="spec-table">
          <thead>
            <tr>
              <th>常见故障现象</th>
              <th>根本原因</th>
              <th>极速解决动作</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>节点测速全部超时 (-1ms)</strong></td>
              <td>电脑系统时间误差 > 60 秒</td>
              <td>在系统设置中重新同步标准北京时间，立即恢复</td>
            </tr>
            <tr>
              <td><strong>国内微信发不出图、淘宝打不开</strong></td>
              <td>代理模式被误调为全局 (Global)</td>
              <td>在客户端界面将模式切换回“规则 (Rule)”分流</td>
            </tr>
            <tr>
              <td><strong>浏览器能翻墙，cmd / git 报错超时</strong></td>
              <td>终端工具默认忽略操作系统系统代理</td>
              <td>在客户端开启“TUN 模式”，或终端注入 http_proxy 变量</td>
            </tr>
            <tr>
              <td><strong>ChatGPT 提示 Access Denied (1020)</strong></td>
              <td>出口节点被 OpenAI 识别为机房广播 IP</td>
              <td>切换至光速云美国住宅专线或新加坡原生节点</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Cluster Links -->
    <section class="content-section">
      <h2 class="t-h2 section-heading">三、延伸知识与品牌选型</h2>
      <div class="related-grid">
        <a href="/faq/" class="related-card">
          <span class="mono-s card-tag">百科FAQ</span>
          <h3 class="t-h4 card-title">跨境网络观测百科与全景 FAQ (83 条深度问答)</h3>
          <p class="t-body-s card-excerpt">涵盖协议、客户端内核、软路由及流媒体全生态疑难解答。</p>
        </a>
        <a href="/brands/" class="related-card">
          <span class="mono-s card-tag">品牌推荐</span>
          <h3 class="t-h4 card-title">42 家主流网络机场品牌库</h3>
          <p class="t-body-s card-excerpt">第一主推光速云，双专线架构，全平台一键专属客户端免配置直连。</p>
        </a>
        <a href="/radar/" class="related-card">
          <span class="mono-s card-tag">安全雷达</span>
          <h3 class="t-h4 card-title">机场跑路预警雷达与阵亡档案馆</h3>
          <p class="t-body-s card-excerpt">5 级风险天梯评估，避开随时可能断流跑路的临时小作坊。</p>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .pillar-page { max-width: var(--canvas); margin: 0 auto; padding: 40px 20px 100px; }
  .page-header { margin-bottom: 56px; }
  .header-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 99px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--grey-20); margin-bottom: 20px; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981; }
  .page-title { margin-bottom: 20px; }
  .page-desc { max-width: 820px; color: var(--grey); line-height: 1.7; margin-bottom: 32px; }
  .cluster-nav { display: flex; flex-wrap: wrap; gap: 10px; }
  .cluster-pill { padding: 8px 18px; border-radius: 99px; font-size: 13px; text-decoration: none; color: var(--grey); background: var(--surface); border: 1px solid var(--grey-20); transition: all 0.2s ease; }
  .cluster-pill:hover, .cluster-pill.is-active { color: var(--white); background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.3); }

  .answer-box { background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 16px; padding: 28px 32px; margin-bottom: 64px; }
  .answer-badge { color: #10b981; font-size: 11px; letter-spacing: 0.5px; margin-bottom: 12px; }
  .answer-heading { margin-bottom: 12px; font-size: 18px; color: var(--white); }
  .answer-text { color: #d1d5db; line-height: 1.8; margin: 0; }

  .content-section { margin-bottom: 72px; }
  .section-heading { margin-bottom: 28px; }

  .platform-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .platform-card { background: var(--surface); border: 1px solid var(--grey-20); border-radius: 16px; padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .platform-head { display: flex; flex-direction: column; gap: 6px; }
  .platform-badge { font-size: 10px; color: #10b981; }
  .platform-title { color: var(--white); margin: 0; font-size: 18px; }
  .platform-desc { color: var(--grey); line-height: 1.6; font-size: 13.5px; margin: 0; }
  .platform-bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .platform-bullets li { font-size: 12.5px; color: #9ca3af; }
  .platform-link { color: var(--white); text-decoration: none; font-size: 13.5px; font-weight: 500; margin-top: 10px; }
  .platform-link:hover { text-decoration: underline; }

  .table-container { overflow-x: auto; border: 1px solid var(--grey-20); border-radius: 14px; background: var(--surface); }
  .spec-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
  .spec-table th, .spec-table td { padding: 16px 20px; border-bottom: 1px solid var(--grey-20); }
  .spec-table th { background: rgba(255, 255, 255, 0.03); color: var(--white); font-weight: 600; }
  .spec-table td { color: var(--grey); }
  .spec-table tr:last-child td { border-bottom: none; }

  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .related-card { background: var(--surface); border: 1px solid var(--grey-20); border-radius: 14px; padding: 24px; text-decoration: none; display: flex; flex-direction: column; gap: 12px; transition: border-color 0.2s ease, transform 0.2s ease; }
  .related-card:hover { border-color: rgba(255, 255, 255, 0.4); transform: translateY(-2px); }
  .card-tag { font-size: 11px; color: var(--grey); }
  .card-title { color: var(--white); margin: 0; font-size: 16px; line-height: 1.4; }
  .card-excerpt { color: var(--grey); font-size: 13px; line-height: 1.6; margin: 0; }

  @media (max-width: 900px) {
    .platform-grid, .related-grid { grid-template-columns: 1fr; }
  }
</style>
