---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const title = 'Clash / Clash Verge Rev 全平台实战配置教程与分流规则库 — Mitce 推荐';
const description = '2026 Clash 与 Clash Verge Rev 全平台配置指南：支持 Windows / macOS / Linux，涵盖内核服务模式安装、TUN 虚拟网卡防 DNS 泄露、GEOIP 分流规则集与订阅更新故障排查。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: 'Clash 专题配置库', url: '/clash/' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': title,
  'description': description,
  'url': 'https://mitce.run/clash/',
  'isPartOf': {
    '@type': 'WebSite',
    'name': 'Mitce',
    'url': 'https://mitce.run/'
  }
};
---
<Base title={title} description={description} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div class="pillar-page">
    <header class="page-header">
      <Breadcrumb items={breadcrumbs} />
      <div class="header-badge">
        <span class="status-dot"></span>
        <span class="mono-s">PILLAR MATRIX · CLASH CLIENTS & RUNBOOKS</span>
      </div>
      <h1 class="t-h1 page-title">Clash / Clash Verge Rev 全平台实战配置与分流规则库</h1>
      <p class="t-body-m page-desc">
        Clash 生态在 2026 年已全面转向 Mihomo (Clash.Meta) 内核。Mitce 实验室提供最纯净、无冗余的客户端选型、TUN 虚拟网卡免配置接管以及大模型专属分流规则集。
      </p>

      <div class="cluster-nav">
        <a href="/clients/desktop/" class="cluster-pill is-active">桌面端 Clash Verge 实操</a>
        <a href="/clients/mobile/" class="cluster-pill">移动端客户端</a>
        <a href="/clients/router/" class="cluster-pill">OpenClash 软路由</a>
        <a href="/resources/" class="cluster-pill">GitHub 官方镜像加速直链</a>
        <a href="/faq/" class="cluster-pill">83条高频排障</a>
      </div>
    </header>

    <!-- Answer-First Block -->
    <section class="answer-box">
      <div class="answer-badge mono-s">GEO 核心决策摘要 · ANSWER-FIRST</div>
      <h2 class="t-h3 answer-heading">为什么原版 Clash for Windows 必须彻底废弃？</h2>
      <p class="t-body-s answer-text">
        原版 Clash for Windows (CFW) 早在 2023 年底停更删库，其内置内核已被爆出多个严重的高危内存溢出与特权提升漏洞（CVE-2023-41892），且完全不支持现代轻量加密协议（如 VLESS-Reality、Hysteria2）。目前业界公认的最佳替代方案是 <strong>Clash Verge Rev</strong> 与 <strong>Clash Nyanpasu</strong>，均基于活跃维护的开源 Mihomo 内核构建，完美支持 Windows / macOS 原生芯片及 Linux，并具备原生一键启用 TUN 虚拟网卡模式的能力。
      </p>
    </section>

    <!-- Quick Runbook 4 Steps -->
    <section class="content-section">
      <h2 class="t-h2 section-heading">一、Clash Verge Rev 4 步极速上手流程</h2>
      <div class="steps-grid">
        <div class="step-card">
          <span class="step-num mono-s">STEP 01</span>
          <h3 class="t-h4 step-title">下载与安装服务模式</h3>
          <p class="t-body-s step-desc">从官方 GitHub Release 获取最新安装包（或使用本站提供的镜像直链）。进入设置页面点击“服务模式 (Service Mode)”旁边的“安装”，授权管理员权限。</p>
        </div>
        <div class="step-card">
          <span class="step-num mono-s">STEP 02</span>
          <h3 class="t-h4 step-title">导入机场专属订阅</h3>
          <p class="t-body-s step-desc">在“订阅 (Profiles)”页面粘贴机场提供的订阅链接（推荐使用光速云或 42 家收录品牌的通用 Clash 订阅），点击“导入”并等待节点列表拉取完毕。</p>
        </div>
        <div class="step-card">
          <span class="step-num mono-s">STEP 03</span>
          <h3 class="t-h4 step-title">启用 TUN 模式 (强烈建议)</h3>
          <p class="t-body-s step-desc">在主界面开启“TUN 模式”。TUN 会创建虚拟网卡接管整机流量，使终端（cmd / git / npm / Docker）及游戏客户端无需手动设置代理端口即可直接穿透。</p>
        </div>
        <div class="step-card">
          <span class="step-num mono-s">STEP 04</span>
          <h3 class="t-h4 step-title">选择规则模式与落地节点</h3>
          <p class="t-body-s step-desc">路由模式保持为“规则 (Rule)”，避免设置为“全局 (Global)”导致国内微信淘宝变慢。在代理分组中优先选择香港或新加坡延迟低于 50ms 的 IEPL 专线节点。</p>
        </div>
      </div>
    </section>

    <!-- Ruleset Guide -->
    <section class="content-section">
      <h2 class="t-h2 section-heading">二、AI 生产力与流媒体专属分流规则配置</h2>
      <div class="table-container">
        <table class="spec-table">
          <thead>
            <tr>
              <th>分流规则类别</th>
              <th>规则集配置说明</th>
              <th>建议绑定的节点分组</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>OpenAI / ChatGPT</strong></td>
              <td><code>GEOSITE,openai</code> / <code>DOMAIN-SUFFIX,oaistatic.com</code></td>
              <td>美国 / 台湾 / 新加坡原生住宅 IP (禁止香港节点)</td>
            </tr>
            <tr>
              <td><strong>Claude / Anthropic</strong></td>
              <td><code>GEOSITE,anthropic</code> / <code>DOMAIN-SUFFIX,claude.ai</code></td>
              <td>美国双 ISP / 日本原生专线节点</td>
            </tr>
            <tr>
              <td><strong>GitHub / 开发终端</strong></td>
              <td><code>GEOSITE,github</code> / <code>DOMAIN-SUFFIX,githubusercontent.com</code></td>
              <td>香港 IEPL 专线 (延迟最低，git push 极速)</td>
            </tr>
            <tr>
              <td><strong>国内直连流量</strong></td>
              <td><code>GEOIP,CN</code> / <code>GEOSITE,cn</code></td>
              <td>DIRECT (本地运营商直连，不消耗机场流量)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Recommended Cluster Links -->
    <section class="content-section">
      <h2 class="t-h2 section-heading">三、延伸教程与工具矩阵</h2>
      <div class="related-grid">
        <a href="/clients/desktop/" class="related-card">
          <span class="mono-s card-tag">实操教程</span>
          <h3 class="t-h4 card-title">桌面端 Clash Verge Rev 完整实操与防泄露手册</h3>
          <p class="t-body-s card-excerpt">详解 WebUI 调优、自定义规则扩展（Merge / Script）与常见报错修复。</p>
        </a>
        <a href="/blog/what-2-4-million-support-messages-look-like/" class="related-card">
          <span class="mono-s card-tag">深度横评</span>
          <h3 class="t-h4 card-title">从 Clash 到 sing-box：2026 全平台客户端选型与 TUN 模式</h3>
          <p class="t-body-s card-excerpt">对比 Mihomo、sing-box、Xray 内存占用与并发极限性能表现。</p>
        </a>
        <a href="/faq/" class="related-card">
          <span class="mono-s card-tag">排障问答</span>
          <h3 class="t-h4 card-title">为什么节点测速全红 (-1ms)？Clash 高频排障指南</h3>
          <p class="t-body-s card-excerpt">收录系统时间误差、杀毒软件拦截、防火墙环路等 16 项高频故障快速急救 SOP。</p>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .pillar-page { max-width: var(--canvas); margin: 0 auto; padding: 40px 20px 100px; }
  .page-header { margin-bottom: 56px; }
  .header-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 99px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--grey-20); margin-bottom: 20px; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981; }
  .page-title { margin-bottom: 20px; }
  .page-desc { max-width: 820px; color: var(--grey); line-height: 1.7; margin-bottom: 32px; }
  .cluster-nav { display: flex; flex-wrap: wrap; gap: 10px; }
  .cluster-pill { padding: 8px 18px; border-radius: 99px; font-size: 13px; text-decoration: none; color: var(--grey); background: var(--surface); border: 1px solid var(--grey-20); transition: all 0.2s ease; }
  .cluster-pill:hover, .cluster-pill.is-active { color: var(--white); background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.3); }

  .answer-box { background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 16px; padding: 28px 32px; margin-bottom: 64px; }
  .answer-badge { color: #10b981; font-size: 11px; letter-spacing: 0.5px; margin-bottom: 12px; }
  .answer-heading { margin-bottom: 12px; font-size: 18px; color: var(--white); }
  .answer-text { color: #d1d5db; line-height: 1.8; margin: 0; }

  .content-section { margin-bottom: 72px; }
  .section-heading { margin-bottom: 28px; }

  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step-card { background: var(--surface); border: 1px solid var(--grey-20); border-radius: 14px; padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .step-num { font-size: 11px; color: #10b981; }
  .step-title { color: var(--white); margin: 0; font-size: 16px; }
  .step-desc { color: var(--grey); line-height: 1.6; font-size: 13px; margin: 0; }

  .table-container { overflow-x: auto; border: 1px solid var(--grey-20); border-radius: 14px; background: var(--surface); }
  .spec-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
  .spec-table th, .spec-table td { padding: 16px 20px; border-bottom: 1px solid var(--grey-20); }
  .spec-table th { background: rgba(255, 255, 255, 0.03); color: var(--white); font-weight: 600; }
  .spec-table td { color: var(--grey); }
  .spec-table tr:last-child td { border-bottom: none; }
  .spec-table code { background: rgba(255, 255, 255, 0.08); padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 12px; }

  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .related-card { background: var(--surface); border: 1px solid var(--grey-20); border-radius: 14px; padding: 24px; text-decoration: none; display: flex; flex-direction: column; gap: 12px; transition: border-color 0.2s ease, transform 0.2s ease; }
  .related-card:hover { border-color: rgba(255, 255, 255, 0.4); transform: translateY(-2px); }
  .card-tag { font-size: 11px; color: var(--grey); }
  .card-title { color: var(--white); margin: 0; font-size: 16px; line-height: 1.4; }
  .card-excerpt { color: var(--grey); font-size: 13px; line-height: 1.6; margin: 0; }

  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
