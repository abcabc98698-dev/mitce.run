---
/**
 * 404. The Framer page has no layout template: its own full-width nav row, no
 * CTA or footer, and the Aero Shards WebGPU field behind the message.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/ui/Button.astro';
import page from '../content/pages/404.json';
const { shards } = page;
---
<Base title={page.meta.title} description={page.meta.description} bare noindex>
  <div class="not-found-page">
    <Nav />
    <section class="not-found">
      <div
        class="shards"
        style={`background-color: ${shards.flatBackground}`}
        data-fx="shard-field"
        aria-hidden="true"
      ></div>
      <div class="content">
        <p class="t-eyebrow">{page.eyebrow}</p>
        <h1 class="t-h1 balance">{page.title}</h1>
        <p class="t-body-m balance not-found-body">{page.body}</p>
        <Button href={page.button.href} class="home-btn">{page.button.label}</Button>
      </div>
    </section>
  </div>
</Base>
<style>
  .not-found-page { background: var(--black); overflow: clip; }
  /* The 404's nav row spans the full viewport, unlike the 1200px layout nav. */
  .not-found-page :global(.topbar) { max-width: none; }
  .not-found {
    position: relative; overflow: clip; width: 100%; min-height: 88vh;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    padding: 120px 20px;
    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
  }
  .shards { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; isolation: isolate; }
  .content {
    position: relative; z-index: 1; width: 100%; max-width: 700px;
    display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 24px; text-align: center;
  }
  .content > p, .content > h1 { width: 100%; }
  .content > .not-found-body { max-width: 520px; }
  @media (max-width: 1199.98px) {
    .not-found { min-height: 85vh; padding: 100px 20px; }
  }
  @media (max-width: 809.98px) {
    .not-found { min-height: 80vh; padding: 80px 20px; }
    .content { gap: 20px; }
    .content > .not-found-body { max-width: 100%; }
    .content :global(.home-btn) { width: 100%; }
  }
</style>
