---
import Base from '../../layouts/Base.astro';
import ClientSubnav from '../../components/ClientSubnav.astro';
import { CLIENTS_DATA } from '../../data/clients';

const title = '2026 网络代理客户端大全与下载配置选型指南 — Mitce 推荐';
const description = '全面汇总 2026 适用 Windows、macOS、iOS、Android、Linux 及 OpenWrt 软路由的主流代理客户端：Clash Verge Rev、v2rayN、Shadowrocket、FlClash、OpenClash，涵盖内核差异、TUN 模式与订阅导入教程。';
---
<Base title={title} description={description}>
  <div class="clients-page">
    <header class="page-head">
      <div class="head-badge">
        <span class="dot"></span>
        <span class="mono-s">CLIENTS & PROTOCOL RUNTIME · 2026 MATRIX</span>
      </div>
      <h1 class="t-h1 page-title">网络代理客户端大全与选型指南</h1>
      <p class="t-body-m page-desc">
        工欲善其事，必先利其器。优质的 IEPL/IPLC 专线必须搭配正确内核的代理客户端，才能完美释放 2Gbps 带宽并避免 DNS 污染与 WebRTC 泄露。Mitce 实验室对主流第三方开源工具与机场专属客户端进行了系统化整理与安装包避坑梳理。
      </p>

      <ClientSubnav current="all" />
    </header>

    <!-- Two Types Explanation -->
    <section class="types-banner">
      <div class="type-box">
        <h2 class="t-h3 type-title">1. 第三方通用客户端 (强烈推荐)</h2>
        <p class="t-body-s type-p">
          例如 <strong>Clash Verge Rev、v2rayN、Shadowrocket、FlClash、Hiddify</strong> 等。支持导入标准的 Clash / sing-box / V2Ray 订阅链接，支持强大的分流规则定制、TUN 虚拟网卡与多机场负载均衡。换机场无需换客户端。
        </p>
      </div>
      <div class="type-box">
        <h2 class="t-h3 type-title">2. 机场专属定制客户端</h2>
        <p class="t-body-s type-p">
          例如 <strong>飞猫云、Firefly、无忧链接</strong> 等提供的官方定制 App。下载登录账号即可一键使用，适合不想手动配置订阅与路由规则的初学者，但大多不支持导出节点至第三方工具。
        </p>
      </div>
    </section>

    <!-- Matrix Grid -->
    <section class="clients-section">
      <h2 class="mono-m sec-title">⚡ 全平台主流客户端横向矩阵</h2>
      <div class="clients-grid">
        {CLIENTS_DATA.map((client) => (
          <div class="client-card">
            <div class="card-top">
              <div class="name-wrap">
                <h3 class="t-h3 client-name">{client.name}</h3>
                {client.badge && <span class="tag-badge">{client.badge}</span>}
              </div>
              <span class="price-tag">{client.pricing}</span>
            </div>

            <div class="platform-tags">
              {client.platform.map(p => <span class="plat-pill">{p}</span>)}
            </div>

            <div class="core-info">
              <span class="mono-s core-label">内核/引擎:</span>
              <span class="mono-s core-val">{client.core}</span>
            </div>

            <p class="t-body-s client-features">{client.features}</p>

            <div class="guide-box">
              <span class="mono-s guide-title">💡 配置速查:</span>
              <p class="mono-s guide-text">{client.setupGuideSummary}</p>
            </div>

            <div class="card-footer">
              <span class="t-body-s target-text">适用：{client.targetAudience}</span>
              <a href={client.githubOrSite} target="_blank" rel="noopener noreferrer" class="btn-repo">
                官方开源发布 ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .clients-page { max-width: var(--canvas); margin: 0 auto; padding: 40px 20px 100px; }
  .page-head { max-width: 900px; display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px; }
  .head-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: var(--surface); border: 1px solid var(--grey-20); border-radius: 999px; width: fit-content; color: var(--grey); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #38bdf8; box-shadow: 0 0 10px #38bdf8; }
  .page-title { color: var(--white); font-size: 42px; line-height: 1.15; }
  .page-desc { color: var(--grey); line-height: 1.6; }

  .types-banner { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 48px; }
  .type-box { padding: 24px; background: rgba(22, 22, 26, 0.7); border: 1px solid var(--grey-20); border-radius: 16px; }
  .type-title { color: var(--white); font-size: 18px; margin-bottom: 8px; }
  .type-p { color: #94a3b8; line-height: 1.6; }

  .clients-section { display: flex; flex-direction: column; gap: 24px; }
  .sec-title { color: #94a3b8; font-size: 14px; }
  .clients-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }

  .client-card {
    background: rgba(20, 20, 24, 0.75); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--grey-20); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 14px;
    transition: transform 0.25s, border-color 0.25s;
  }
  .client-card:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, 0.25); }

  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .name-wrap { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .client-name { color: var(--white); font-size: 20px; margin: 0; font-weight: 700; }
  .tag-badge { font-family: var(--font-mono); font-size: 11px; padding: 2px 8px; border-radius: 4px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .price-tag { font-family: var(--font-mono); font-size: 11px; color: var(--grey); background: var(--surface); padding: 3px 8px; border-radius: 6px; }

  .platform-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .plat-pill { font-family: var(--font-mono); font-size: 10px; padding: 2px 6px; border-radius: 4px; background: rgba(255, 255, 255, 0.05); color: #cbd5e1; }

  .core-info { display: flex; gap: 8px; align-items: center; font-size: 12px; background: rgba(0, 0, 0, 0.3); padding: 6px 10px; border-radius: 6px; }
  .core-label { color: var(--grey); }
  .core-val { color: #38bdf8; font-weight: 600; }

  .client-features { color: #94a3b8; line-height: 1.5; font-size: 13px; }

  .guide-box { background: rgba(16, 16, 18, 0.6); padding: 12px; border-radius: 8px; border-left: 3px solid #38bdf8; }
  .guide-title { color: #f8fafc; font-size: 11px; font-weight: 600; display: block; margin-bottom: 4px; }
  .guide-text { color: #64748b; font-size: 11px; line-height: 1.5; }

  .card-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--grey-20); flex-wrap: wrap; }
  .target-text { color: var(--grey); font-size: 12px; flex: 1; }
  .btn-repo {
    padding: 8px 14px; border-radius: 8px; background: var(--surface); border: 1px solid var(--grey-20);
    color: var(--white); font-size: 12px; text-decoration: none; font-family: var(--font-mono); transition: all 0.2s;
  }
  .btn-repo:hover { background: var(--white); color: var(--black); }

  @media (max-width: 991.98px) {
    .types-banner, .clients-grid { grid-template-columns: 1fr; }
    .page-title { font-size: 32px; }
  }
</style>
